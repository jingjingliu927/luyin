{
  "name": "luyin",
  "version": "3.0.0",
  "description": "语音驱动的全能桌面助手 - 多 ASR Provider + 录音转写、截图、记事本、任务、闹钟、计算器",
  "private": true,
  "main": "main.js",
  "author": "luyin contributors",
  "scripts": {
    "start": "electron .",
    "web": "node server/index.js",
    "web:lan": "HOST=0.0.0.0 node server/index.js",
    "test": "node --test server/*.test.js",
    "build": "electron-builder --mac dmg"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^4",
    "multer": "^1.4.5-lts.2",
    "recorder-core": "^1",
    "undici": "^7.29.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "electron": "^33",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.luyin.recorder-assistant",
    "productName": "录音助手",
    "directories": {
      "buildResources": "buildResources",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server/**/*",
      "!server/*.test.js",
      "!server/test-*.js",
      "!server/*.py",
      "public/**/*",
      "!data/**/*",
      "!recordings/**/*"
    ],
    "asarUnpack": [
      "node_modules/recorder-core/**",
      "public/**"
    ],
    "extraResources": [
      {
        "from": "buildResources/trayTemplate.png",
        "to": "trayTemplate.png"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "buildResources/icon.icns",
      "entitlements": "buildResources/entitlements.mac.plist",
      "entitlementsInherit": "buildResources/entitlements.mac.plist",
      "hardenedRuntime": true,
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "录音功能需要使用麦克风",
        "NSScreenCaptureUsageDescription": "截图功能需要屏幕录制权限"
      }
    },
    "dmg": {
      "title": "录音助手"
    }
  },
  "license": "MIT",
  "overrides": {
    "qs": "^6.16.1"
  }
}
