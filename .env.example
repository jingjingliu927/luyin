# 录音助手配置示例。复制为仓库根目录的 .env 后按需填写；
# 也可以直接启动服务，在「控制面板 → 设置」里填写，会自动写入 .env。
# 留空表示使用默认值（或不启用该功能）。

# ── 识别引擎 ──
# 录音时用哪家做实时转写。本地 FunASR 连不上时，会自动改用已配置好的讯飞。
# 当前识别引擎：xfyun / xfyun_llm / aliyun / funasr
ASR_PROVIDER=funasr

# ── 讯飞实时转写（标准版） ──
# 在讯飞开放平台「实时语音转写」应用里获取。AppID 同时用于大模型版和声纹。
# AppID
XFYUN_APP_ID=
# APIKey
XFYUN_API_KEY=
# 识别语种（cn 中文，en 英文） [高级]
XFYUN_LANG=
# 角色分离（2 表示开启讯飞角色分离） [高级]
XFYUN_ROLE_TYPE=
# 标点过滤（0 表示返回结果不带标点） [高级]
XFYUN_PUNC=
# 垂直领域（如 edu、court、finance 等领域个性化参数） [高级]
XFYUN_PD=
# 远近场模式（1 远场，2 近场） [高级]
XFYUN_VAD_MDN=
# 语言识别模式（按讯飞文档填写 engLangType） [高级]
XFYUN_ENG_LANG_TYPE=

# ── 讯飞实时转写大模型 ──
# 开放平台控制台里的 APIKey / APISecret 对应下面两项；AppID 与标准版共用。
# APIKey（accessKeyId）
XFYUN_ACCESS_KEY_ID=
# APISecret（accessKeySecret）
XFYUN_ACCESS_KEY_SECRET=
# 识别语种（autodialect 为中文及方言自动识别） [高级]
XFYUN_LLM_LANG=
# 角色分离（2 表示开启说话人分离） [高级]
XFYUN_LLM_ROLE_TYPE=
# 声纹匹配（1 表示用已注册声纹匹配说话人） [高级]
XFYUN_LLM_ENG_SPK_MATCH=
# 垂直领域 [高级]
XFYUN_LLM_PD=
# 标点 [高级]
XFYUN_LLM_PUNC=
# 远近场模式 [高级]
XFYUN_LLM_VAD_MDN=
# 采样率（需与录音格式一致，一般不要改） [高级]
XFYUN_LLM_SAMPLE_RATE=
# 音频编码（需与录音格式一致，一般不要改） [高级]
XFYUN_LLM_AUDIO_ENCODE=

# ── 阿里云智能语音 ──
# 在阿里云智能语音交互控制台获取项目 AppKey，以及有权限的 AccessKey。
# 项目 AppKey
ASR_APP_KEY=
# AccessKey ID
ALIBABA_CLOUD_ACCESS_KEY_ID=
# AccessKey Secret
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# ── 本地 FunASR / SenseVoice ──
# 免费的本地识别，需要先在本机启动 FunASR WebSocket 服务。
# 服务地址
FUNASR_WS_URL=
# 识别模式：2pass / online / offline
FUNASR_MODE=
# 数字规整（ITN）（把「一百二十」写成「120」）
FUNASR_ITN=
# 热词（按 FunASR 服务要求的格式填写）
FUNASR_HOTWORDS=
# 分片大小 [高级]
FUNASR_CHUNK_SIZE=
# 分片间隔 [高级]
FUNASR_CHUNK_INTERVAL=

# ── 说话人与声纹 ──
# 本地分人策略和讯飞声纹 1:N 认人。声纹密钥不填时复用讯飞标准版的 APIKey / 大模型的 APISecret。
# 分人策略：single / balanced / multi
SPEAKER_PROFILE=
# 声纹匹配阈值（0~1，分数达到这个值才认定是某个人）
XFYUN_VP_MATCH_THRESHOLD=
# 声纹库分组
XFYUN_VP_GROUP_ID=
# 声纹 APIKey [高级]
XFYUN_VP_API_KEY=
# 声纹 APISecret [高级]
XFYUN_VP_API_SECRET=

# ── 会议助手（补充项） ──
# AppCode、AppSecret、AgentMatchFlowPath 和开关在「会议助手」页配置，这里是其余几项。
# 会议结束提示词（停止录音时发给智能体的那句话）
BACH_FINAL_PROMPT=
# 校验 HTTPS 证书（内网自签证书连不上时才关闭）
BACH_TLS_REJECT_UNAUTHORIZED=
# 备用 API Base URL（只在会议助手页没填 Base URL 时使用） [高级]
BACH_API_BASE_URL=

# ── 会议总结接口 ──
# 「语音录入」里生成会议纪要时调用的接口。鉴权三选一：自定义请求头 > Bearer API Key > token 头。
# 接口地址
MEETING_SUMMARY_API_URL=
# API Key（Bearer）
MEETING_SUMMARY_API_KEY=
# token 请求头
MEETING_SUMMARY_API_TOKEN=
# 自定义请求头名称 [高级]
MEETING_SUMMARY_AUTH_HEADER=
# 自定义请求头值 [高级]
MEETING_SUMMARY_AUTH_VALUE=
# 超时（毫秒） [高级]
MEETING_SUMMARY_TIMEOUT_MS=

# ── 任务智能体 ──
# 可选：说「创建任务…」「提交 bug…」时，把内容同时发给一个 Kaleido 超级智能体处理。三项都填才会调用，否则只在本地建任务。
# 智能体调用地址
KALEIDO_TASK_AGENT_URL=
# AppCode
KALEIDO_APP_CODE=
# AppSecret
KALEIDO_APP_SECRET=
# 鉴权地址 [高级]
KALEIDO_AUTH_URL=
